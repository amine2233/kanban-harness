{
  "name": "mvp-dashboard-workspace",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter mvp-dashboard dev",
    "build": "pnpm --filter mvp-dashboard build",
    "preview": "pnpm --filter mvp-dashboard preview",
    "typecheck": "pnpm --filter mvp-dashboard typecheck",
    "lint": "pnpm --filter mvp-dashboard lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter mvp-dashboard test",
    "test:watch": "pnpm --filter mvp-dashboard test:watch",
    "test:coverage": "pnpm --filter mvp-dashboard test:coverage"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
